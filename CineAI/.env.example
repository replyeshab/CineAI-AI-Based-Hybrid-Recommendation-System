# --- copy to .env (never commit it) ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=                 # python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_URL=https://your-domain.com
COOKIE_SECURE=true          # false only for http://localhost
TMDB_KEY=                   # themoviedb.org API key (v3 key or v4 read token)
SMTP_HOST=                  # needed for password-reset emails (SES, Postmark, SendGrid, Gmail app password...)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CineAI <no-reply@your-domain.com>
GOOGLE_CLIENT_ID=          # Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Add your site URL under 'Authorised JavaScript origins'.
OTP_REQUIRED=true           # email codes need SMTP_* above
REDIS_PASSWORD=change-me-too   # protects the internal Redis (cache + rate limits)
ENV=prod                     # prod = strict startup checks (https, SMTP, secure cookies). Use ENV=dev for http://localhost testing
